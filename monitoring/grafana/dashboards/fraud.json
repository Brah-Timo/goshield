{
  "__inputs": [{ "name": "DS_PROMETHEUS", "label": "Prometheus", "type": "datasource", "pluginId": "prometheus" }],
  "title": "GoShield — Fraud Analytics",
  "uid": "goshield-fraud",
  "schemaVersion": 38,
  "version": 2,
  "refresh": "30s",
  "time": { "from": "now-24h", "to": "now" },
  "tags": ["goshield", "fraud", "ai"],
  "panels": [
    {
      "id": 1, "title": "Fraud Detection Rate (%)", "type": "gauge",
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 6 },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "minVizWidth": 0, "minVizHeight": 0,
        "thresholds": { "mode": "absolute", "steps": [
          { "color": "green", "value": null },
          { "color": "yellow", "value": 5 },
          { "color": "red", "value": 15 }
        ]}
      },
      "targets": [{ "expr": "100 * sum(rate(goshield_claims_total{status=\"flagged\"}[1h])) / sum(rate(goshield_claims_total[1h]))", "legendFormat": "Fraud Rate %", "datasource": { "uid": "${DS_PROMETHEUS}" } }]
    },
    {
      "id": 2, "title": "Avg Fraud Score", "type": "stat",
      "gridPos": { "x": 6, "y": 0, "w": 4, "h": 3 },
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [{ "expr": "avg(goshield_fraud_score_analyzed)", "legendFormat": "Avg Score", "datasource": { "uid": "${DS_PROMETHEUS}" } }]
    },
    {
      "id": 3, "title": "Claims Processed (24h)", "type": "stat",
      "gridPos": { "x": 10, "y": 0, "w": 4, "h": 3 },
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["sum"] } },
      "targets": [{ "expr": "sum(increase(goshield_claims_total[24h]))", "legendFormat": "Claims", "datasource": { "uid": "${DS_PROMETHEUS}" } }]
    },
    {
      "id": 4, "title": "AI Model Inference P99 (ms)", "type": "stat",
      "gridPos": { "x": 14, "y": 0, "w": 4, "h": 3 },
      "options": { "colorMode": "background", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] },
        "thresholds": { "mode": "absolute", "steps": [
          { "color": "green", "value": null }, { "color": "yellow", "value": 200 }, { "color": "red", "value": 500 }
        ]}
      },
      "targets": [{ "expr": "histogram_quantile(0.99, rate(goshield_ai_inference_duration_seconds_bucket[5m])) * 1000", "legendFormat": "P99 ms", "datasource": { "uid": "${DS_PROMETHEUS}" } }]
    },
    {
      "id": 5, "title": "High-Risk Claims Queued", "type": "stat",
      "gridPos": { "x": 18, "y": 0, "w": 6, "h": 3 },
      "options": { "colorMode": "background", "reduceOptions": { "calcs": ["lastNotNull"] },
        "thresholds": { "mode": "absolute", "steps": [
          { "color": "green", "value": null }, { "color": "yellow", "value": 10 }, { "color": "red", "value": 50 }
        ]}
      },
      "targets": [{ "expr": "goshield_claims_pending_review", "legendFormat": "Pending", "datasource": { "uid": "${DS_PROMETHEUS}" } }]
    },
    {
      "id": 6, "title": "Fraud Score Distribution (histogram)", "type": "timeseries",
      "gridPos": { "x": 0, "y": 6, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" } } },
      "targets": [
        { "expr": "sum(rate(goshield_fraud_score_bucket{le=\"0.25\"}[5m]))", "legendFormat": "0-25%", "datasource": { "uid": "${DS_PROMETHEUS}" } },
        { "expr": "sum(rate(goshield_fraud_score_bucket{le=\"0.5\"}[5m])) - sum(rate(goshield_fraud_score_bucket{le=\"0.25\"}[5m]))", "legendFormat": "25-50%", "datasource": { "uid": "${DS_PROMETHEUS}" } },
        { "expr": "sum(rate(goshield_fraud_score_bucket{le=\"0.75\"}[5m])) - sum(rate(goshield_fraud_score_bucket{le=\"0.5\"}[5m]))", "legendFormat": "50-75%", "datasource": { "uid": "${DS_PROMETHEUS}" } },
        { "expr": "sum(rate(goshield_fraud_score_bucket{le=\"1.0\"}[5m])) - sum(rate(goshield_fraud_score_bucket{le=\"0.75\"}[5m]))", "legendFormat": "75-100%", "datasource": { "uid": "${DS_PROMETHEUS}" } }
      ]
    },
    {
      "id": 7, "title": "Claims by Status (last 1h)", "type": "piechart",
      "gridPos": { "x": 12, "y": 6, "w": 6, "h": 8 },
      "options": { "pieType": "donut", "displayLabels": ["name", "percent"] },
      "targets": [
        { "expr": "sum(increase(goshield_claims_total{status=\"approved\"}[1h]))", "legendFormat": "Approved", "datasource": { "uid": "${DS_PROMETHEUS}" } },
        { "expr": "sum(increase(goshield_claims_total{status=\"rejected\"}[1h]))", "legendFormat": "Rejected", "datasource": { "uid": "${DS_PROMETHEUS}" } },
        { "expr": "sum(increase(goshield_claims_total{status=\"flagged\"}[1h]))", "legendFormat": "Flagged", "datasource": { "uid": "${DS_PROMETHEUS}" } },
        { "expr": "sum(increase(goshield_claims_total{status=\"pending\"}[1h]))", "legendFormat": "Pending", "datasource": { "uid": "${DS_PROMETHEUS}" } }
      ]
    },
    {
      "id": 8, "title": "AI Inference Errors / min", "type": "timeseries",
      "gridPos": { "x": 18, "y": 6, "w": 6, "h": 8 },
      "options": { "tooltip": { "mode": "single" } },
      "targets": [{ "expr": "rate(goshield_ai_inference_errors_total[1m]) * 60", "legendFormat": "Errors/min", "datasource": { "uid": "${DS_PROMETHEUS}" } }]
    },
    {
      "id": 9, "title": "Kafka Consumer Lag (claims topics)", "type": "timeseries",
      "gridPos": { "x": 0, "y": 14, "w": 12, "h": 7 },
      "targets": [
        { "expr": "kafka_consumer_group_lag{topic=~\"claims.*\"}", "legendFormat": "{{topic}} lag", "datasource": { "uid": "${DS_PROMETHEUS}" } }
      ]
    },
    {
      "id": 10, "title": "Review Turnaround Time (P95, minutes)", "type": "stat",
      "gridPos": { "x": 12, "y": 14, "w": 6, "h": 7 },
      "options": { "colorMode": "background", "reduceOptions": { "calcs": ["lastNotNull"] },
        "thresholds": { "mode": "absolute", "steps": [
          { "color": "green", "value": null }, { "color": "yellow", "value": 60 }, { "color": "red", "value": 240 }
        ]}
      },
      "targets": [{ "expr": "histogram_quantile(0.95, rate(goshield_review_duration_seconds_bucket[1h])) / 60", "legendFormat": "P95 min", "datasource": { "uid": "${DS_PROMETHEUS}" } }]
    },
    {
      "id": 11, "title": "Claims by Type (24h)", "type": "bargauge",
      "gridPos": { "x": 18, "y": 14, "w": 6, "h": 7 },
      "options": { "orientation": "horizontal", "displayMode": "gradient", "reduceOptions": { "calcs": ["sum"] } },
      "targets": [{ "expr": "sum by (claim_type) (increase(goshield_claims_total[24h]))", "legendFormat": "{{claim_type}}", "datasource": { "uid": "${DS_PROMETHEUS}" } }]
    }
  ]
}
